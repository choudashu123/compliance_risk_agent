# ==============================================================================
# Compliance & Risk Agent - Environment Configuration
# Copy this file to '.env' and fill in ONE provider's credentials.
# The app auto-detects the provider from whichever key is present (see app/config.py)
# and routes every call through LangChain's init_chat_model — no code changes needed.
# With no key set, it runs the offline `mock` analyzer (used by tests/CI).
# ==============================================================================

# --- Option 1: Google Gemini (recommended) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Option 2: OpenAI ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# --- Option 3: Anthropic Claude ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Option 4: Local Ollama (no key) ---
# GRC_LLM_MODE=ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_URL=http://localhost:11434

# --- Force a provider / the offline analyzer regardless of keys present ---
# GRC_LLM_MODE=mock        # auto (default) | gemini | openai | anthropic | ollama | mock

# --- Embeddings & storage (defaults are pre-configured) ---
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_SIZE=700
# CHUNK_OVERLAP=100
